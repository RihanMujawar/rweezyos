Rweezy OS -- kernel identity customization patch.

This patch applies the Rweezy customizations on top of a pristine Linux
7.2 source tree. It:

  * adds the read-only /proc/rweezy proc entry (kernel/rweezy.c),
  * registers the rweezy object in fs/proc/Makefile, and
  * introduces the CONFIG_RWEEZY Kconfig option in fs/proc/Kconfig.

Apply from the top of the unpacked kernel tree with:

    patch -p1 < kernel/rweezy.patch

The local version suffix (-rweezy) lives in src/linux/localversion-rweezy
and is applied automatically by the kernel build.

--- a/fs/proc/Kconfig
+++ b/fs/proc/Kconfig
@@ -127,3 +127,12 @@ config PROC_CPU_RESCTRL
 config PROC_CPU_RESCTRL
 	def_bool n
 	depends on PROC_FS
+
+config RWEEZY
+	bool "Rweezy OS identity interface"
+	default y
+	depends on PROC_FS
+	help
+	  Creates the read-only /proc/rweezy entry which exposes the
+	  Rweezy OS identity, kernel version, ABI version and build string.
+
--- a/fs/proc/Makefile
+++ b/fs/proc/Makefile
@@ -36,3 +36,4 @@
 proc-$(CONFIG_PRINTK)	+= kmsg.o
 proc-$(CONFIG_PROC_PAGE_MONITOR)	+= page.o
 proc-$(CONFIG_BOOT_CONFIG)	+= bootconfig.o
+proc-$(CONFIG_RWEEZY)	+= rweezy.o
--- /dev/null
+++ b/fs/proc/rweezy.c
@@ -0,0 +1,51 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * Rweezy OS -- kernel identity interface.
+ *
+ * Exposes a read-only /proc/rweezy entry carrying the operating system
+ * identity, the running kernel version, the Rweezy ABI version and the
+ * kernel build string.
+ */
+
+#include <linux/init.h>
+#include <linux/kernel.h>
+#include <linux/module.h>
+#include <linux/proc_fs.h>
+#include <linux/seq_file.h>
+#include <linux/utsname.h>
+#include <linux/version.h>
+
+#define RWEEZY_ABI_VERSION 1
+
+static int rweezy_show(struct seq_file *m, void *v)
+{
+	seq_printf(m, "Rweezy OS\n");
+	seq_printf(m, "Kernel: %s\n", init_utsname()->release);
+	seq_printf(m, "Rweezy ABI: %d\n", RWEEZY_ABI_VERSION);
+	seq_printf(m, "Build: %s %s\n", init_utsname()->version,
+	 	   init_utsname()->machine);
+	return 0;
+}
+
+static int rweezy_open(struct inode *inode, struct file *file)
+{
+	return single_open(file, rweezy_show, NULL);
+}
+
+static const struct proc_ops rweezy_proc_ops = {
+	.proc_open	= rweezy_open,
+	.proc_read	= seq_read,
+	.proc_lseek	= seq_lseek,
+	.proc_release	= single_release,
+};
+
+static int __init rweezy_init(void)
+{
+	proc_create("rweezy", 0444, NULL, &rweezy_proc_ops);
+	return 0;
+}
+
+fs_initcall(rweezy_init);
+
+MODULE_LICENSE("GPL");
+MODULE_DESCRIPTION("Rweezy OS kernel identity interface");
+MODULE_AUTHOR("Rehan Mujawar");
